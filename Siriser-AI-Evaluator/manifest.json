{
  "manifest_version": 3,
  "name": "Siriser AI Auto Evaluator",
  "version": "1.0.16",
  "description": "自动读取 Siriser Image Benchmark 任务，调用自定义视觉 API 完成五维评分并填表提交。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Siriser AI Auto Evaluator"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["config.js", "scoring-prompt.js", "api.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
